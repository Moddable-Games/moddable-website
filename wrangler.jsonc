{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moddable-website",
  "main": "_worker.js",
  "compatibility_date": "2026-06-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    { "binding": "STORE", "id": "01d09ee59d5a41e0a43cd60eedb9d345" }
  ]
}
